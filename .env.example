# SecBrain — environment variables
#
# Copy to `.env` (git-ignored) and fill in what you need. NOTHING here is required to install,
# run the test suite, or try the quickstart in examples/quickstart/.
#
# Every variable in this file is read by the code today. (An earlier version of this file listed
# planned settings that nothing consumed; they were removed so the file cannot mislead.)
# Full explanations: docs/guide/configuration.md

# ---------------------------------------------------------------------------------------------
# LLM vendors — only for the LLM passes (extract / cluster summaries / resolve / ask).
# All traffic goes through src/gateway/; set the keys for the vendors you want routed to.
# ---------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=            # Gemini. The availability gate checks GOOGLE_API_KEY ...
GEMINI_API_KEY=            # ... and the adapter reads GEMINI_API_KEY: set both to the same value.
TOGETHER_API_KEY=          # open-weights models via Together (OpenAI-compatible endpoint)
XAI_API_KEY=               # optional: xAI via OpenAI-compatible endpoint
NVIDIA_API_KEY=            # optional: NVIDIA NIM via OpenAI-compatible endpoint
TAVILY_API_KEY=            # web verification of contested claims (ADR-016)

# Routing switches (all optional; defaults shown)
# SECBRAIN_PLAN_B=                  # set to 1: route bulk extraction to open-weights models
# SECBRAIN_PLANB_VARIANT=gemini     # gemini | grok  (which family handles sentiment / questions)
# SECBRAIN_CONFLICT_PROVIDER=together
# SECBRAIN_TG_TIMEOUT=90            # seconds, Together requests
# SECBRAIN_CASCADE=                 # set to 1: calibrated confidence cascade + router (ADR-023)
# SECBRAIN_JOINT_RESOLVER=          # set to 1: L1-anchored joint-confidence resolver (ADR-026)
# SECBRAIN_OFFLINE=                 # set to 1: never call the network from conflict/teams paths
# Model ids are overridable per task: SECBRAIN_MODEL_CHEAP, SECBRAIN_MODEL_INTERVIEW,
# SECBRAIN_MODEL_CONFLICT, SECBRAIN_MODEL_CONFLICT_LLAMA, SECBRAIN_MODEL_HARDEST,
# SECBRAIN_MODEL_SONNET, SECBRAIN_MODEL_GEMINI_FLASH, SECBRAIN_MODEL_FALLBACK, SECBRAIN_TG_MODEL
# (defaults live in src/gateway/api.py).

# ---------------------------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------------------------
# SECBRAIN_DATA_DIR=data                       # SQLite + Kùzu graph + dumps (same as --data-dir)
# SECBRAIN_KUZU_BUFFER_POOL_BYTES=4294967296   # cap Kùzu's buffer pool; unset = ~80 % of RAM.
#                                              # Set this on a workstation before opening a big graph.
# SECBRAIN_BUNDLE=                             # directory of a built corpus bundle; enables the
#                                              # /api/v1/dossier and /api/v1/evidence routes
# GRAPHRAG_DB_PATH=./data/graph/repo.db        # repo-context index used by `graphrag-mcp`

# ---------------------------------------------------------------------------------------------
# Website crawler (ADR-019 / ADR-020)
# ---------------------------------------------------------------------------------------------
# REQUIRED to crawl: an honest, contactable user-agent. The adapter refuses to start without it.
CRAWL4AI_USER_AGENT=SecBrain/1.6 (+you@example.com)
# SCRAPINGBEE_API_KEY=                         # opt-in proxy fallback; off unless enabled per domain
# TRAFILATURA_SUBPROCESS_BIN=trafilatura       # main-content fallback, run out-of-process

# ---------------------------------------------------------------------------------------------
# Human-in-the-loop
# ---------------------------------------------------------------------------------------------
# SECBRAIN_REVIEWER=reviewer                   # name recorded when you claim a review item
